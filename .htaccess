# ------------------------------
# Pitch Detectors — Full SEO & AI Optimized
# ------------------------------

Options -Indexes
RewriteEngine On

# 1. Force HTTPS + NON-WWW
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.pitchdetectors\.com$ [NC]
RewriteRule ^ https://pitchdetectors.com%{REQUEST_URI} [L,R=301]

# 2. Trailing Slash Normalization (except files)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://pitchdetectors.com/$1/ [R=301,L]

# 3. Sitemap Rewrite
RewriteRule ^site_map\.xml$ /site_map.php [L,QSA]

<IfModule mod_headers.c>
  <FilesMatch "(^|/)(sitemap|site_map)\.xml$">
    Header set Content-Type "application/xml; charset=UTF-8"
    Header set Cache-Control "public, max-age=3600"
    Header set Pragma "cache"
    Header set Expires "Wed, 21 Oct 2030 07:28:00 GMT"
  </FilesMatch>
</IfModule>

# 4. Custom 404 Page
ErrorDocument 404 /404.html

# 5. Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:;"
</IfModule>

