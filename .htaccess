# ==============================
# Clean & SEO Safe .htaccess
# ==============================

RewriteEngine On

# Sitemap rewrite
RewriteRule ^(sitemap|site_map)\.xml$ /site_map.php [L]

# ------------------------------
# 1. Force NON-WWW
# ------------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# ------------------------------
# 2. Force HTTPS
# ------------------------------
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ------------------------------
# 3. Static Headers for Sitemap & ads.txt / robots.txt
# ------------------------------
<IfModule mod_headers.c>
  <FilesMatch "(^|/)(sitemap|site_map)\.xml$">
    Header set Content-Type "application/xml; charset=UTF-8"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
  <FilesMatch "^(ads|robots)\.txt$">
    <IfModule mod_authz_core.c>
      Require all granted
    </IfModule>
    Header set Content-Type "text/plain; charset=UTF-8"
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# ------------------------------
# 4. Custom 404 Page
# ------------------------------
ErrorDocument 404 /404.html

# ------------------------------
# 5. Security Headers
# ------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------
# 6. GZIP Compression
# ------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json
</IfModule>
